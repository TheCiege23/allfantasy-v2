{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npx prisma generate && AF_RAILWAY_TAILWIND_PREBUILD=1 npm run build && node scripts/railway-verify-next-build.cjs"
  },
  "deploy": {
    "startCommand": "npm run start:railway",
    "healthcheckPath": "/api/af-debug/sha",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
